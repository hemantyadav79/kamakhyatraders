# =============================================================================
# Kamakhya Traders — Environment Variables (EXAMPLE / TEMPLATE)
# -----------------------------------------------------------------------------
# Copy this file to  apps/web/.env.local  and fill in the REAL values.
# NEVER commit the real .env.local — it is gitignored on purpose.
# On Vercel, add every one of these under Project → Settings → Environment Variables.
# Nothing here (domain, phone, keys) is hardcoded anywhere in the source.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# No trailing slash. Change this one value to switch domains (.in / .com / vercel).
NEXT_PUBLIC_SITE_URL=https://kamakhyatraders.in

# --- Business contact (public — safe to expose in the browser) ----------------
NEXT_PUBLIC_BUSINESS_PHONE_PRIMARY=919835989984
NEXT_PUBLIC_BUSINESS_PHONE_SECONDARY=917979171462
NEXT_PUBLIC_WHATSAPP_NUMBER=919835989984

# --- Supabase (text/product database) -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
# Server-only. FULL ACCESS — never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# --- Cloudinary (product images) ----------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_PRESET=kamakhya_products

# --- Gmail SMTP (contact form) ------------------------------------------------
# Use a Gmail "App Password" (16 chars), NOT your normal Gmail password.
# Create at: https://myaccount.google.com/apppasswords  (2FA must be ON).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=kamakhyatradeshouse@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
CONTACT_TO_EMAIL=kamakhyatradeshouse@gmail.com

# --- Hidden admin panel (/admin-gunnu-org) ------------------------------------
# CHANGE THESE before going live — the values shared in chat are now public.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me-to-a-strong-password
# Long random string used to sign the admin login cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=generate-a-long-random-secret-here
