{
  "name": "kamakhya-traders",
  "version": "1.0.0",
  "private": true,
  "description": "Kamakhya Traders - Building materials supplier website (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "web:dev": "npm run dev --workspace=web",
    "web:build": "npm run build --workspace=web",
    "web:start": "npm run start --workspace=web"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "overrides": {
    "postcss": ">=8.5.23",
    "sharp": ">=0.35.0"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "npm@11.9.0"
}
